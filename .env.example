# Copier ce fichier en .env puis adapter les valeurs. Le fichier .env n'est jamais versionne.
# Il est lu par Docker Compose et par l'application (format cle=valeur, sans guillemets).

# Nom de la base creee par le conteneur PostgreSQL
POSTGRES_DB=portail_edr

# Connexion de l'application (URL JDBC)
DATABASE_URL=jdbc:postgresql://localhost:5432/portail_edr
DATABASE_USERNAME=portail_edr
DATABASE_PASSWORD=changer-ce-mot-de-passe

# Dossier des pieces deposees (CNI, copie du titre foncier), hors du projet en production.
# Facultatif en local : par defaut, le dossier "donnees" du projet (ignore par Git).
UPLOAD_DIR=donnees
